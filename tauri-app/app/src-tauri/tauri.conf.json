{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radio Cartographer",
  "version": "0.1.7",
  "identifier": "edu.unc.physics.radio-cartographer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Radio Cartographer",
        "width": 1024,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "rpm", "appimage"],
    "externalBin": ["binaries/radio-cartographer-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "E463F242A70C9EE4CB90B9FA8FB6AB1825F065B4"
    }
  }
}

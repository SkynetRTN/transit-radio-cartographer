# Radio Cartographer — top-level task runner.
#
# All commands run from the `tauri-app/` directory. The justfile is intentionally
# thin: each recipe is a one-liner that wraps the underlying tool so contributors
# get one-line muscle memory (`just test`, `just build`) without memorising flags.

set shell := ["bash", "-euo", "pipefail", "-c"]
set windows-shell := ["pwsh.exe", "-NoLogo", "-NoProfile", "-Command"]

#store os as string
os_name := os()
default:
    @just --list

# --all-packages is required, not optional. This pyproject.toml is a uv
# *workspace root* whose own dependencies are just numpy; the engine's real
# runtime deps (astropy) live in the `engine` member. A plain `uv sync` syncs
# only the root project plus the dev group, so astropy never lands in .venv/,
# PyInstaller quietly omits it, and the sidecar dies on startup with
# `ModuleNotFoundError: No module named 'astropy'` — which the app can only
# report as the opaque "sidecar closed stdout" toast.
#
# Python — install every workspace member's deps from uv.lock into .venv/
sync:
    uv sync --all-packages

# Run every test suite: engine (pytest) and front-end (vitest).
test: test-engine test-app

# Engine only — pytest over `engine/tests/`.
test-engine:
    uv run pytest

# Front-end only — vitest in CI mode over `app/src/__tests__/`.
test-app:
    cd app && npm test

# Python — lint and format check
lint:
    uv run ruff check .
    uv run ruff format --check .

# Automatically fix formatting and linting issues
fmt:
    uv run ruff format .
    uv run ruff check --fix .

# Python — type-check the engine package
typecheck:
    uv run mypy

# Front-end — install npm deps and produce a production web bundle
build:
    cd app && npm install && npm run build

# Vite serves React with HMR; tauri-cli watches src-tauri/ and relaunches the
# window when Rust changes. Quit the window (or Ctrl-C) to stop.
#
# If nvm is installed, source it and switch to the .nvmrc version automatically
# so contributors don't have to remember `nvm use` each shell. Falls back to the
# ambient `npm` (and its engine warning) when nvm is absent.
#
# Launch the desktop window with hot reload.
dev:
    @ {{ if os_name == "windows" { "just _dev-windows" } else { "just _dev-unix" } }}

# Internal helper for Windows
_dev-windows:
    cd app && npm run tauri dev

# Internal helper for Mac/Linux
_dev-unix:
    #!/usr/bin/env bash
    set -euo pipefail
    cd app
    NVM_SH="${NVM_DIR:-$HOME/.nvm}/nvm.sh"
    if [ -s "$NVM_SH" ]; then
        . "$NVM_SH"
        nvm use --silent || nvm install
    fi
    exec npm run tauri dev

# Engine — produce a standalone sidecar binary via PyInstaller and rename
# to the target-triple convention Tauri's externalBin expects.
sidecar:
    @ {{ if os_name == "windows" { "just _sidecar-windows" } else { "just _sidecar-unix" } }}

# Not a `#!/usr/bin/env pwsh` shebang recipe: `just` writes those to an
# extensionless temp file, and `pwsh -File` rejects any script not ending in
# `.ps1` ("does not have a '.ps1' extension"). Call a real .ps1 file instead.
_sidecar-windows:
    pwsh -NoLogo -NoProfile -File scripts/build-sidecar.ps1

_sidecar-unix:
    #!/usr/bin/env bash
    set -euo pipefail
    uv run pyinstaller engine/sidecar.spec --distpath app/src-tauri/binaries/ --noconfirm

    # PyInstaller downgrades an unresolvable import to a line in
    # warn-sidecar.txt and still exits 0, so a venv missing a runtime dep ships
    # a binary that dies the moment the app spawns it. Most of that file is
    # benign (conditional numpy._core.* lookups), so match only the engine's
    # declared third-party deps — keep this list in sync with
    # engine/pyproject.toml. The trailing " -" anchors on the exact module so
    # `numpy._core.foo` does not trip the `numpy` pattern.
    WARN=build/sidecar/warn-sidecar.txt
    PATTERN='^missing module named (astropy|numpy) -'
    if [ -f "$WARN" ] && grep -qE "$PATTERN" "$WARN"; then
        echo "error: sidecar is missing a runtime dependency:" >&2
        grep -E "$PATTERN" "$WARN" | cut -d' ' -f4 | sort -u | sed 's/^/  /' >&2
        echo "hint: run 'just sync', then rebuild." >&2
        exit 1
    fi

    TRIPLE=$(rustc -vV | sed -n 's|host: ||p')
    BIN="app/src-tauri/binaries/radio-cartographer-engine-${TRIPLE}"
    mv -f "app/src-tauri/binaries/radio-cartographer-engine" "$BIN"

    # A frozen binary can still fail at startup for reasons the build never
    # sees — a missing module, or macOS library validation refusing the
    # bundled libpython when the exe is signed with the hardened runtime.
    # Both reach the user only as "sidecar closed stdout", so prove here that
    # the thing actually answers. serve() loops over stdin, so closing the
    # pipe ends the process; capture into a variable rather than piping to
    # grep, whose early exit would SIGPIPE the child under `pipefail`.
    OUT=$(printf '%s\n' '{"jsonrpc":"2.0","id":1,"method":"ping","params":{}}' | "$BIN" 2>&1 || true)
    case "$OUT" in
        *'"pong"'*) echo "sidecar ok: $BIN" ;;
        *)
            echo "error: sidecar built but did not answer ping:" >&2
            echo "$OUT" >&2
            exit 1
            ;;
    esac

# Whole app — build the bundled Tauri artifact (.exe setup / .dmg / .AppImage).
# Bundling depends on the sidecar binary, so `just sidecar` must succeed first.
package: sidecar build
    cd app && npm run tauri build
